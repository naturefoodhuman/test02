# 创建/修改该文件的LLM大模型：Arena.ai Agent Mode
# 创建时间（北京时间）：2026-06-25 00:00:00

# FORGE local secrets template.
# Copy this file to .env and fill real values locally.
# .env is gitignored; do not commit real keys.

# Search API fallback keys (optional but recommended for resilient web search)
TAVILY_API_KEY="tvly-your-key-here"
SERPER_API_KEY="your-serper-key-here"
BRAVE_API_KEY=""

# Optional API proxy. Empty string disables explicit proxy for API fallbacks.
# Default in code: http://127.0.0.1:7890
NETWORK_SEARCH_API_PROXY="http://127.0.0.1:7890"

# Privacy Gateway local DB encryption key. Use a long local random string.
PII_MAP_ENCRYPTION_KEY="replace-with-local-random-32chars"


# NVIDIA NIM free-tier key pool (local only; do not commit real keys)
# Use indexed variables for the local NIM sidecar proxy.
NVIDIA_API_KEY_1="replace-with-nvidia-key-1"
NVIDIA_API_KEY_2="replace-with-nvidia-key-2"
# NVIDIA_API_KEY_3="replace-with-nvidia-key-3"

# Local NIM sidecar proxy. Smart Proxy uses it only when FORGE_USE_NIM_PROXY=1.
FORGE_USE_NIM_PROXY=1
NIM_PROXY_HOST="127.0.0.1"
NIM_PROXY_PORT=4010
NIM_PROXY_BASE_URL="http://127.0.0.1:4010/v1"
NIM_PROXY_API_KEY="nim-proxy-local"
NIM_PROXY_PER_KEY_RPM=35
NIM_PROXY_PER_KEY_CONCURRENCY=2
NIM_PROXY_DEFAULT_COOLDOWN_SECONDS=300
NIM_PROXY_RETRY_AFTER_CAP_SECONDS=900
NIM_PROXY_QUEUE_TIMEOUT_SECONDS=900
NIM_PROXY_READ_TIMEOUT_SECONDS=120
NIM_PROXY_MAX_ATTEMPTS_PER_REQUEST=1
NIM_PROXY_ENABLE_FALLBACK=0
NIM_PRIMARY_MODEL="z-ai/glm-5.2"
NIM_FALLBACK_MODEL="deepseek-ai/DeepSeek-V4-Pro"
