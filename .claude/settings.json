{
  "permissions": {
  "defaultMode": "acceptEdits",
  "allow": [
    "Read(*)",
    "Edit(*)",
    "MultiEdit(*)",
    "Glob(*)",
    "Grep(*)",
    "LS(*)",
    "NotebookEdit(*)",
    "TodoRead(*)",
    "TodoWrite(*)",
    "WebFetch(*)",
    "WebSearch(*)",
    "Bash(*)",
    "mcp__*"
  ],
  "deny": [
    "Bash(rm -rf /*)",
    "Bash(rm -rf ~*)",
    "Bash(rm -rf .*)",
    "Bash(mkfs*)",
    "Bash(dd *)",
    "Bash(sudo *)",
    "Bash(su *)",
    "Bash(chmod 777*)",
    "Bash(chown *)",
    "Bash(shutdown*)",
    "Bash(reboot*)",
    "Bash(halt*)",
    "Bash(poweroff*)",
    "Bash(systemctl stop*)",
    "Bash(systemctl disable*)",
    "Read(**/.env)",
    "Read(**/.env.*)",
    "Read(**/.ssh/**)",
    "Read(**/.aws/**)",
    "Read(**/.gnupg/**)",
    "Read(**/id_rsa*)",
    "Read(**/id_ed25519*)",
    "Read(**/.netrc)",
    "Read(**/.npmrc)",
    "Edit(**/.env)",
    "Edit(**/.env.*)",
    "Edit(**/.ssh/**)",
    "Edit(**/.aws/**)",
    "Bash(curl -X POST*)",
    "Bash(curl --data*)",
    "Bash(curl -d *)",
    "Bash(wget *)",
    "Bash(nc *)",
    "Bash(scp *)",
    "Bash(ssh *)",
    "Bash(git push --force*)",
    "Bash(git push -f*)",
    "Bash(git reset --hard*)",
    "Bash(git clean -fd*)",
    "Bash(npm publish*)",
    "Bash(kill -9 1*)",
    "Bash(killall*)",
    "Bash(pkill*)",
    "Bash(iptables*)"
  ]
  }
}
