        "--timeout-navigation=30000",
        "--timeout-action=10000"
      ],
      "env": {
        "PLAYWRIGHT_PROFILE": "ai-public",
        "PLAYWRIGHT_ALLOW_PRIVATE_PROFILE": "0"
