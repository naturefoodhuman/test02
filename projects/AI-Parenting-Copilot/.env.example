# AI Parenting Copilot environment example.
# Copy to .env for local development. Never commit real secrets.

PARENTING_ENV=dev
PARENTING_APP_NAME=AI Parenting Copilot
PARENTING_LOG_LEVEL=INFO

# APC-T003 will introduce real PostgreSQL / Mosquitto / PowerSync settings.
PARENTING_DATABASE__URL=postgresql+asyncpg://parenting:parenting@127.0.0.1:5432/parenting
PARENTING_MQTT__HOST=127.0.0.1
PARENTING_MQTT__PORT=1883
PARENTING_POWERSYNC__URL=http://127.0.0.1:8080

# Factory model gateway reuse. Cloud calls must pass Privacy Gateway first.
PARENTING_MODEL_GATEWAY__BASE_URL=http://127.0.0.1:4000
PARENTING_MODEL_GATEWAY__DEFAULT_PLAN=parenting-local-first

# Local-only secret file paths, gitignored.
PARENTING_FCM__SERVICE_ACCOUNT_FILE=runtime/secrets/fcm-service-account.json
PARENTING_MEDIA__ROOT=runtime/media
