# 创建/修改该文件的LLM大模型：Claude Opus 4.8
# 创建时间（北京时间）：2026-08-10 00:00:00
#
# deploy/.env.example —— Docker Compose 本地基础设施环境样例。
# 依据：ENGINEERING_DESIGN §1.3（进程拓扑）、§7（存储）、§13（消息总线）；TASK_BACKLOG APC-T003。
# 复制为 deploy/.env（gitignored）并按需覆盖；缺省值仅用于本地 dev。
# 真实密钥不得提交。应用层 PARENTING_* 配置见项目根 .env.example。
#
# 裁决（2026-08-10）：本目录用独立库名 AI_parenting_dev，与兄弟项目
# projects/AI-Parenting-Copilot/ 的 parenting 库隔离，避免迁移版本记录冲突。

# ---- PostgreSQL（架构 §7）----
POSTGRES_USER=parenting
POSTGRES_PASSWORD=parenting
POSTGRES_DB=AI_parenting_dev
POSTGRES_PORT=5432

# ---- Mosquitto MQTT（架构 §13）----
MOSQUITTO_PORT=1883

# ---- PowerSync Service（架构 §9）----
POWERSYNC_PORT=8080
