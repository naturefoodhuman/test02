# 创建/修改该文件的LLM大模型：Claude Opus 4.8
# 创建时间（北京时间）：2026-08-02 00:00:00

# ============================================================
# AI Parenting Copilot — 环境变量样例
# 复制为 .env 并填入本地真实值；.env 必须被 gitignore，不得提交真实密钥。
# 加载顺序（ENGINEERING_DESIGN §8.1）：defaults → config/*.yaml → runtime/*.yaml → .env → 环境变量(PARENTING_*) → CLI
# ============================================================

# ---- 运行环境 ----
PARENTING_ENV=dev
# dev: mock camera/mmWave + FakeModelClient；prod: 真实设备 + 真实模型

# ---- 数据库（PostgreSQL 15+）----
PARENTING_DATABASE__URL=postgresql+asyncpg://parenting:parenting@127.0.0.1:5432/parenting
PARENTING_DATABASE__ECHO=false

# ---- MQTT（Mosquitto 2.x）----
PARENTING_MQTT__HOST=127.0.0.1
PARENTING_MQTT__PORT=1883
PARENTING_MQTT__CLIENT_ID=parenting-server

# ---- PowerSync ----
PARENTING_POWERSYNC__API_URL=http://127.0.0.1:8080

# ---- 模型网关（复用工厂 Smart Proxy 4000）----
PARENTING_MODEL_GATEWAY__BASE_URL=http://127.0.0.1:4000
PARENTING_MODEL_GATEWAY__TEXT_TIMEOUT=30
PARENTING_MODEL_GATEWAY__VISION_TIMEOUT=60

# ---- 隐私网关（复用工厂 _infra/network/privacy）----
PARENTING_PRIVACY__POLICY_CONFIG=config/privacy_policy.yaml

# ---- 本地 RAG（复用工厂）----
PARENTING_RAG__DB_PATH=runtime/rag.db
PARENTING_RAG__EMBED_BASE_URL=http://127.0.0.1:11434

# ---- FCM（仅 alert_id/level/type 触发信号）----
PARENTING_FCM__CREDENTIALS_PATH=runtime/secrets/fcm-service-account.json

# ---- 摄像头（RTSP/ISAPI，厂商云必须关闭）----
PARENTING_CAMERA__DEVICES_CONFIG=config/devices.yaml

# ---- NAS 备份 ----
PARENTING_BACKUP__NAS_PATH=/Volumes/FamilyNAS/parenting-backups

# ---- 云端 LLM fallback（仅脱敏文本，经 Privacy Gateway）----
# 留空则不启用云端 fallback，仅用本地模型
PARENTING_CLOUD_LLM__API_KEY=

# ---- 可观测性 ----
PARENTING_OBSERVABILITY__LOG_LEVEL=INFO
PARENTING_OBSERVABILITY__OTEL_ENABLED=false
PARENTING_OBSERVABILITY__JAEGER_ENDPOINT=http://127.0.0.1:4317
